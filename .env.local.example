# ============================================================
# KY — Variables de entorno (ejemplo)
# Copiar a .env.local y completar. NUNCA commitear .env.local.
# Regla PSAI / Protocolo Maestro: sólo NEXT_PUBLIC_* puede ir al cliente,
# y sólo para la anon key de Supabase.
# ============================================================

# --- Supabase (proyecto propio de EC, NO el de Newen) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # sólo server-side

# --- Cifrado en reposo (pgcrypto): clave para columnas sensibles ---
# La usa el backend para insertar/leer respuesta_cruda.texto / .transcripcion.
EC_PGCRYPTO_KEY=cambiar-por-clave-larga-aleatoria

# --- API de Claude (motores de turno y síntesis) ---
ANTHROPIC_API_KEY=sk-ant-...
KY_MODELO_TURNO=claude-haiku-4-5
KY_MODELO_SINTESIS=claude-opus-5

# --- STT en tiempo real (proveedor a confirmar: Deepgram / AssemblyAI / Azure) ---
# El backend acuña un token efímero; la key permanente nunca sale del server.
STT_PROVIDER=deepgram
STT_API_KEY=
STT_TOKEN_TTL_SECONDS=60

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Integración Newen (FDW): datos del rol de solo lectura de EC ---
# Se configuran en el proyecto Newen, no acá. Se documentan en spec/DEPLOYMENT.md.
# EC_NEWEN_READER_ROLE=newen_reader

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
KY_PROMPT_VERSION=v0.1.0
KY_MAPA_INDAGACION_VERSION=v0.1.0
